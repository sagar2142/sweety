# ---------------------------------------------------------------
# Sweety API – copy this file to `.env` and adjust if needed.
# The defaults match the Postgres container in docker-compose.yml.
# ---------------------------------------------------------------

# development | test | production
NODE_ENV=development

# Port the API listens on
PORT=4000

# Main database (used by the app, migrations and the seed script)
DATABASE_URL=postgres://sweety:sweety@localhost:5434/sweety

# Separate database used ONLY by the automated tests (its tables are wiped).
# The database name must end with "_test".
TEST_DATABASE_URL=postgres://sweety:sweety@localhost:5434/sweety_test

# Secret used to sign login tokens (JWT). Use a long random string (min 16 chars).
JWT_SECRET=replace-with-a-long-random-secret

# How long a login stays valid (e.g. 1h, 7d)
JWT_EXPIRES_IN=7d

# Allowed browser origin(s) for CORS, comma separated
CORS_ORIGIN=http://localhost:5180

# Timezone used to decide what "today" is (for the "date cannot be in the future" rule)
APP_TIMEZONE=Asia/Kolkata

# bcrypt cost factor (10–12 is a good range)
BCRYPT_SALT_ROUNDS=10
