# ---------------------------------------------------------------
# Optional settings for docker-compose.yml – copy to `.env` to change them.
# (The API and client have their own .env.example files in server/ and client/.)
# ---------------------------------------------------------------

# Host port for PostgreSQL (5434 avoids clashing with a local Postgres on 5432)
DB_PORT=5434

# Host port for the full app (nginx serving the React build + /api proxy)
WEB_PORT=8080

# Secret for signing login tokens in the API container. Use a long random string.
JWT_SECRET=replace-with-a-long-random-secret

# How long a login stays valid
JWT_EXPIRES_IN=7d

# Timezone used for the "date cannot be in the future" rule
APP_TIMEZONE=Asia/Kolkata
