# ---------------------------------------------------------------
# Sweety client – copy to `.env` only if you need to change these.
# ---------------------------------------------------------------

# Base URL the browser uses for API calls. Keep "/api" when the client is served
# by Vite (dev proxy below) or by the nginx container (docker-compose).
VITE_API_URL=/api

# Development only: where the Vite dev server forwards /api requests.
VITE_API_PROXY_TARGET=http://localhost:4000

# Development only: port for the Vite dev server.
CLIENT_PORT=5180
